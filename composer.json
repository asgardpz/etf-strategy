{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "ibasetech/etf-strategy",
  "type": "project",
  "description": "Laravel ETF dividend strategy monitor using real TWSE data.",
  "keywords": ["laravel", "twse", "etf", "investment"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "setup": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force"],
    "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"#93c5fd,#fbbf24,#86efac\" \"php artisan serve\" \"php artisan schedule:work\" \"php artisan queue:listen --tries=1\" --names=http,schedule,queue"],
    "test": ["@php artisan config:clear", "@php artisan test"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
